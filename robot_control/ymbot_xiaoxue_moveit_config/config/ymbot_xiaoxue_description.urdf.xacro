<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ymbot_xiaoxue_description">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ymbot_xiaoxue_description urdf file -->
    <xacro:include filename="$(find ymbot_xiaoxue_description)/urdf/ymbot_xiaoxue_description.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="ymbot_xiaoxue_description.ros2_control.xacro" />


    <xacro:ymbot_xiaoxue_description_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
